# Copy this file to .env.local and fill in the Firebase Admin credentials.
# Never commit a real service-account JSON or private key.

FIREBASE_SERVICE_ACCOUNT_JSON='{"projectId":"your-project-id","clientEmail":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","privateKey":"-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"}'

# run_local.sh creates LUCID_SERVICE_TOKEN automatically in .env.lucid.
LUCID_BACKEND_URL=http://127.0.0.1:8010
LUCID_BTW_RATE=0.21
LUCID_ENV=development
LUCID_ALLOWED_HOSTS=localhost,127.0.0.1
LUCID_CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002
LUCID_MAX_REQUEST_BODY_BYTES=2097152
LUCID_BACKEND_TIMEOUT_MS=10000
LUCID_RATE_LIMIT_BACKEND=memory
LUCID_AUTO_CREATE_SCHEMA=true
EFL_LOCAL_STORE_ENABLED=true
